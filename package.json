{
  "name": "vet-calorie-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema backend/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema backend/database/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema backend/database/prisma/schema.prisma",
    "db:seed": "tsx backend/database/prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.0.0",
    "exceljs": "^4.4.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "prisma": {
    "schema": "backend/database/prisma/schema.prisma",
    "seed": "tsx backend/database/prisma/seed.ts"
  }
}
