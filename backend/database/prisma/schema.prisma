generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Species {
  CAT
  DOG
}

enum Sex {
  MALE
  FEMALE
}

enum ProductKind {
  PRODUCT
  SUPPLEMENT
  RECIPE
}

enum RationMode {
  DAILY
  WEEKLY
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED
}

enum UserRole {
  ADMIN
  USER
}

model User {
  deletedAt        DateTime?
  deletedById      String?
  email            String            @unique
  name             String
  id               String            @id @default(cuid())
  username         String            @unique
  passwordHash     String
  role             UserRole          @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  pets             Pet[]
  calculations     Calculation[]
  customers        Customer[]
  productGroups    ProductGroup[]
  nutrients        Nutrient[]
  products         Product[]
  productTags      ProductTag[]
  rations          Ration[]
  notifications    Notification[]
  invoices         Invoice[]
  tablePreferences TablePreference[]
  breedStandards   BreedStandard[]
}

model Session {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  csrfTokenHash String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Module {
  deletedAt    DateTime?
  deletedById  String?
  id           String                 @id @default(cuid())
  name         String                 @unique
  species      Species
  archived     Boolean                @default(false)
  versions     ModuleFormulaVersion[]
  calculations Calculation[]
}

model ModuleFormulaVersion {
  deletedAt    DateTime?
  deletedById  String?
  id           String        @id @default(cuid())
  moduleId     String
  formula      String
  description  String?
  techBegin    DateTime      @map("tech_begin") @db.Timestamp(3)
  techEnd      DateTime      @map("tech_end") @db.Timestamp(3)
  createdAt    DateTime      @default(now())
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  calculations Calculation[]

  @@unique([moduleId, techBegin])
  @@index([moduleId, techBegin, techEnd])
}

model Pet {
  deletedAt    DateTime?
  deletedById  String?
  id           String           @id @default(cuid())
  name         String
  species      Species
  sex          Sex?
  breedId      String?
  actualWeight Float
  idealWeight  Float
  bcs          Int              @default(5)
  birthdate    DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  breed        Breed?           @relation(fields: [breedId], references: [id], onDelete: Restrict)
  calculations Calculation[]
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  measurements PetMeasurement[]
  rations      Ration[]
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([breedId])
  @@index([customerId])
  @@index([userId])
}

model Breed {
  deletedAt         DateTime?
  deletedById       String?
  id                String          @id
  species           Species
  nameRu            String
  nameEn            String
  maleIdealWeight   Float
  femaleIdealWeight Float
  pets              Pet[]
  standards         BreedStandard[]

  @@index([species, nameRu])
}

model Calculation {
  deletedAt        DateTime?
  deletedById      String?
  id               String                @id @default(cuid())
  petId            String?
  moduleId         String
  formulaVersionId String
  actualWeight     Float
  idealWeight      Float
  bcs              Int
  energyFactor     Float                 @default(1)
  lactationWeek    Int                   @default(1)
  childrenCount    Int                   @default(0)
  baseEnergy       Int
  adjustedEnergy   Int
  protein          Float                 @default(0)
  fat              Float                 @default(0)
  carbs            Float                 @default(0)
  createdAt        DateTime              @default(now())
  pet              Pet?                  @relation(fields: [petId], references: [id], onDelete: Restrict)
  module           Module                @relation(fields: [moduleId], references: [id])
  formulaVersion   ModuleFormulaVersion  @relation(fields: [formulaVersionId], references: [id])
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  nutrients        CalculationNutrient[]
  rations          Ration[]

  @@index([createdAt])
  @@index([petId])
  @@index([userId, createdAt])
  @@index([formulaVersionId])
}

model CalculationNutrient {
  deletedAt     DateTime?
  deletedById   String?
  calculationId String
  nutrientId    String
  targetAmount  Float
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  nutrient      Nutrient    @relation(fields: [nutrientId], references: [id], onDelete: Restrict)

  @@id([calculationId, nutrientId])
  @@index([nutrientId])
}

model BreedStandard {
  deletedAt          DateTime?
  deletedById        String?
  id                 String                  @id @default(cuid())
  breedId            String
  sex                Sex
  idealWeight        Float
  proteinPer1000Kcal Float
  fatPer1000Kcal     Float
  carbsPer1000Kcal   Float
  source             String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  breed              Breed                   @relation(fields: [breedId], references: [id], onDelete: Restrict)
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  nutrients          BreedStandardNutrient[]

  @@unique([userId, breedId, sex])
  @@index([breedId, sex])
}

model BreedStandardNutrient {
  deletedAt         DateTime?
  deletedById       String?
  standardId        String
  nutrientId        String
  amountPer1000Kcal Float
  standard          BreedStandard @relation(fields: [standardId], references: [id], onDelete: Restrict)
  nutrient          Nutrient      @relation(fields: [nutrientId], references: [id], onDelete: Restrict)

  @@id([standardId, nutrientId])
  @@index([nutrientId])
}

model Customer {
  deletedAt   DateTime?
  deletedById String?
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pets        Pet[]
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, name])
}

model PetMeasurement {
  deletedAt   DateTime?
  deletedById String?
  id          String    @id @default(cuid())
  petId       String
  measuredAt  DateTime  @default(now())
  weight      Float
  bcs         Int?
  note        String?
  pet         Pet       @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@index([petId, measuredAt])
}

model ProductGroup {
  deletedAt   DateTime?
  deletedById String?
  isShared    Boolean        @default(false)
  id          String         @id @default(cuid())
  name        String
  parentId    String?
  parent      ProductGroup?  @relation("ProductGroupTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProductGroup[] @relation("ProductGroupTree")
  products    Product[]
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Nutrient {
  deletedAt          DateTime?
  deletedById        String?
  isReferenceOnly    Boolean                 @default(false)
  isShared           Boolean                 @default(false)
  id                 String                  @id @default(cuid())
  code               String
  name               String
  category           String
  unit               String
  values             ProductNutrient[]
  calculationTargets CalculationNutrient[]
  standardValues     BreedStandardNutrient[]
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, code])
  @@index([userId, category, name])
}

model Product {
  deletedAt        DateTime?
  deletedById      String?
  isShared         Boolean           @default(false)
  id               String            @id @default(cuid())
  name             String
  kind             ProductKind       @default(PRODUCT)
  groupId          String?
  baseQuantity     Float             @default(100)
  unit             String            @default("г")
  calories         Float             @default(0)
  protein          Float             @default(0)
  fat              Float             @default(0)
  carbs            Float             @default(0)
  source           String?
  sourceExternalId String?
  archived         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  group            ProductGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  nutrients        ProductNutrient[]
  tags             ProductTagLink[]
  measures         ProductMeasure[]
  rationItems      RationItem[]
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, source, sourceExternalId])
  @@index([userId, groupId, name])
}

model ProductTag {
  deletedAt   DateTime?
  deletedById String?
  isShared    Boolean          @default(false)
  id          String           @id @default(cuid())
  name        String
  slug        String
  products    ProductTagLink[]
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, slug])
  @@index([userId, name])
}

model ProductTagLink {
  deletedAt   DateTime?
  deletedById String?
  productId   String
  tagId       String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  tag         ProductTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductNutrient {
  deletedAt   DateTime?
  deletedById String?
  productId   String
  nutrientId  String
  amount      Float?
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  nutrient    Nutrient  @relation(fields: [nutrientId], references: [id], onDelete: Restrict)

  @@id([productId, nutrientId])
}

model ProductMeasure {
  deletedAt   DateTime?
  deletedById String?
  id          String       @id @default(cuid())
  productId   String
  name        String
  grams       Float
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  rationItems RationItem[]

  @@index([productId])
}

model Ration {
  deletedAt        DateTime?
  deletedById      String?
  id               String       @id @default(cuid())
  name             String
  petId            String?
  mode             RationMode   @default(DAILY)
  targetEnergy     Float        @default(0)
  tolerancePercent Float        @default(10)
  calculationId    String?
  note             String?
  sharedToken      String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  pet              Pet?         @relation(fields: [petId], references: [id], onDelete: Restrict)
  calculation      Calculation? @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  items            RationItem[]
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, petId, updatedAt])
  @@index([calculationId])
}

model RationItem {
  deletedAt       DateTime?
  deletedById     String?
  productSnapshot Json?
  id              String          @id @default(cuid())
  rationId        String
  productId       String
  measureId       String?
  quantity        Float           @default(1)
  grams           Float
  day             Int             @default(1)
  enabled         Boolean         @default(true)
  ration          Ration          @relation(fields: [rationId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  measure         ProductMeasure? @relation(fields: [measureId], references: [id], onDelete: Restrict)

  @@index([rationId, day])
  @@index([productId])
}

model Notification {
  deletedAt   DateTime?
  deletedById String?
  id          String    @id @default(cuid())
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model Invoice {
  deletedAt   DateTime?
  deletedById String?
  id          String        @id @default(cuid())
  number      String
  description String
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, number])
  @@index([userId, createdAt])
}

model TablePreference {
  deletedAt   DateTime?
  deletedById String?
  userId      String
  tableName   String
  config      Json
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, tableName])
}

model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model CaptchaChallenge {
  id         String    @id
  secret     String
  challenge  Json
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
