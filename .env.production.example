# Скопируйте файл в .env.production только на сервере и замените значения.
# Пароль в DATABASE_URL должен быть URL-encoded, если содержит специальные символы.
POSTGRES_DB=vmerukormi
POSTGRES_USER=vmerukormi
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://vmerukormi:replace-with-a-long-random-password@postgres:5432/vmerukormi?schema=public
# Временно false для запуска по HTTP. Обязательно заменить на true после настройки HTTPS.
AUTH_COOKIE_SECURE=false
